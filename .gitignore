# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/tmp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/.utmp/

# Codex의 로컬 Unity 실행 경로는 기기별 설정이다. 토큰/연결 정보를 저장소에 넣지 않는다.
/.codex/config.toml

# MemoryCaptures can get excessive in size.
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# AI API 키 등 민감정보
.env
*.secrets.json
.claude/settings.local.json

# Android/iOS signing keys and private certificates
*.keystore
*.jks
*.p12
*.p8
*.pem
*.key
.DS_Store

# 로컬 스토어 빌드 산출물
/output/ios/
/output/android/
/output/test-results/

# BACKND 콘솔에서 내려받는 앱 설정에는 프로젝트 식별·서명 값이 포함될 수 있다.
/Assets/TheBackend/Resources/TheBackendSettings.asset
/Assets/TheBackend/Resources/TheBackendSettings.asset.meta

# Apps in Toss 로컬 설정·빌드 산출물
**/AITCredentials.asset
**/AITCredentials.asset.meta
/ait-build/
/webgl/
Assets/StreamingAssets/build_info
Assets/StreamingAssets/build_info.meta
Assets/Resources/AITVersionInfo.json
Assets/Resources/AITVersionInfo.json.meta

# AITTemplate은 고정 SDK와 Assets/Editor의 패치 원본으로 빌드 시 재생성한다.

# Apps in Toss SDK - 자동 보호 패턴
Assets/WebGLTemplates/

# 로컬 검증·촬영 출력과 Unity 복구 사본 (기존 추적 문서는 유지)
/output/
/Assets/_Recovery/
/Assets/_Recovery.meta
/Assets/StreamingAssets/google-services-desktop.json
/Assets/StreamingAssets/google-services-desktop.json.meta
